{
  "TableName": "Users",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true,
      "Comment": "Primary key - unique user identifier"
    },
    {
      "FieldName": "Username",
      "DataType": "varchar(100)",
      "NotNullable": true,
      "Unique": true,
      "Comment": "Unique username for login"
    },
    {
      "FieldName": "Email",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Unique": true,
      "Comment": "User's email address - must be unique"
    },
    {
      "FieldName": "PasswordHash",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Comment": "Hashed password using bcrypt"
    },
    {
      "FieldName": "FirstName",
      "DataType": "varchar(100)",
      "NotNullable": false,
      "Comment": "User's first name"
    },
    {
      "FieldName": "LastName",
      "DataType": "varchar(100)",
      "NotNullable": false,
      "Comment": "User's last name"
    },
    {
      "FieldName": "IsActive",
      "DataType": "boolean",
      "NotNullable": true,
      "DefaultValue": true,
      "Comment": "Whether the user account is active"
    },
    {
      "FieldName": "IsAdmin",
      "DataType": "boolean",
      "NotNullable": true,
      "DefaultValue": false,
      "Comment": "Whether user has admin privileges - grants all permissions"
    },
    {
      "FieldName": "CustomerId",
      "DataType": "int",
      "NotNullable": false,
      "DefaultValue": null,
      "Comment": "Optional customer ID if user belongs to a specific customer"
    },
    {
      "FieldName": "UserType",
      "DataType": "varchar(20)",
      "NotNullable": true,
      "DefaultValue": "internal",
      "Comment": "User type: internal, customer, or fictitious"

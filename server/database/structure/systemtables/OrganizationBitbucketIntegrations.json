{
  "TableName": "OrganizationBitbucketIntegrations",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true,
      "Comment": "Primary key - unique Bitbucket integration instance"
    },
    {
      "FieldName": "OrganizationId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - reference to Organizations.Id"
    },
    {
      "FieldName": "Name",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Comment": "Display name for this Bitbucket integration instance"
    },
    {
      "FieldName": "IsEnabled",
      "DataType": "tinyint(1)",
      "NotNullable": true,
      "DefaultValue": "1",
      "Comment": "Flag indicating if Bitbucket integration is active"
    },
    {
      "FieldName": "IsDefault",
      "DataType": "tinyint(1)",
      "NotNullable": true,
      "DefaultValue": "0",
      "Comment": "Default instance for this organization when no explicit integration is selected"
    },
    {
      "FieldName": "BitbucketUrl",
      "DataType": "varchar(500)",
      "NotNullable": true,
      "Comment": "Bitbucket base URL (https://bitbucket.org for Cloud, or Server/DC base URL)"
    },
    {
      "FieldName": "BitbucketUsername",
      "DataType": "varchar(255)",
      "NotNullable": false,
      "Comment": "Atlassian account email for Bitbucket Cloud Basic auth with API tokens (not Bitbucket username)"
    },
    {
      "FieldName": "BitbucketToken",
      "DataType": "text",
      "NotNullable": true,
      "Comment": "Encrypted Bitbucket Cloud API token or Server/DC personal access token"
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when integration was created"
    },
    {
      "FieldName": "UpdatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when integration was last updated"
    }
  ]
}

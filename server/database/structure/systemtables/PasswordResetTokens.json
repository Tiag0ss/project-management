{
  "TableName": "PasswordResetTokens",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true
    },
    {
      "FieldName": "UserId",
      "DataType": "int",
      "NotNullable": true
    },
    {
      "FieldName": "TokenHash",
      "DataType": "varchar(128)",
      "NotNullable": true
    },
    {
      "FieldName": "ExpiresAt",
      "DataType": "datetime",
      "NotNullable": true
    },
    {
      "FieldName": "UsedAt",
      "DataType": "datetime",
      "NotNullable": false,
      "DefaultValue": null
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP"
    }
  ]
}

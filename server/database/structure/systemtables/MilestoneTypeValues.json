{
  "TableName": "MilestoneTypeValues",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true,
      "Comment": "Primary key - unique milestone type identifier"
    },
    {
      "FieldName": "OrganizationId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - reference to Organizations.Id for organization-specific milestone types"
    },
    {
      "FieldName": "TypeName",
      "DataType": "varchar(100)",
      "NotNullable": true,
      "Comment": "Display name of the milestone type"
    },
    {
      "FieldName": "IconSvg",
      "DataType": "varchar(50)",
      "NotNullable": false,
      "Comment": "Identifier of selected SVG icon for this milestone type"
    },
    {
      "FieldName": "ColorCode",
      "DataType": "varchar(7)",
      "NotNullable": false,
      "Comment": "Color code in hex format (e.g., #FF5733) for UI display"
    },
    {
      "FieldName": "SortOrder",
      "DataType": "int",
      "NotNullable": true,
      "DefaultValue": "0",
      "Comment": "Order for displaying milestone types in lists"
    },
    {
      "FieldName": "IsDefault",
      "DataType": "tinyint(1)",
      "NotNullable": true,
      "DefaultValue": "0",
      "Comment": "Whether this is the default type for new milestones"
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when milestone type was created"
    }
  ],
  "Relationships": [
    {
      "Name": "MilestoneTypeOrganization",
      "Description": "Milestone Type belongs to an Organization",
      "FromField": "OrganizationId",
      "ToTable": "Organizations",
      "ToField": "Id",
      "Type": "ManyToOne"
    }
  ]
}

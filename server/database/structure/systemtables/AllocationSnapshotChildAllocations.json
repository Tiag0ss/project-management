      "DataType": "int",
      "NotNullable": false,
      "Comment": "Original TaskAllocationHeaders.Id for header remapping on restore"
    },
    {
      "FieldName": "ParentTaskId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - reference to parent Tasks.Id"
    },
    {

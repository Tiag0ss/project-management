      "DataType": "int",
      "NotNullable": true,
      "Comment": "Hierarchy level"
    },
    {
      "FieldName": "StartTime",
      "DataType": "varchar(5)",
      "NotNullable": false,
      "Comment": "Planned start time HH:MM"
    },
    {
      "FieldName": "EndTime",
      "DataType": "varchar(5)",
      "NotNullable": false,
      "Comment": "Planned end time HH:MM"
    }
  ]

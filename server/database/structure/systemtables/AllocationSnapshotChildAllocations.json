      "Comment": "Foreign key - reference to AllocationSnapshots.Id"
    },
    {
      "FieldName": "OriginalChildAllocId",
      "DataType": "int",
      "NotNullable": false,
      "Comment": "Original TaskChildAllocations.Id at snapshot time"
    },
    {

{
  "TableName": "OrganizationGitHubIntegrations",
  "PrimaryKeyFields": "Id",
  "Fields": [
    {
      "FieldName": "Id",
      "DataType": "int",
      "NotNullable": true,
      "AutoIncrement": true,
      "Comment": "Primary key - unique GitHub integration instance"
    },
    {
      "FieldName": "OrganizationId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - reference to Organizations.Id"
    },
    {
      "FieldName": "Name",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Comment": "Display name for this GitHub integration instance"
    },
    {
      "FieldName": "IsEnabled",
      "DataType": "tinyint(1)",
      "NotNullable": true,
      "DefaultValue": "1",
      "Comment": "Flag indicating if GitHub integration is active"
    },
    {
      "FieldName": "IsDefault",
      "DataType": "tinyint(1)",
      "NotNullable": true,
      "DefaultValue": "0",
      "Comment": "Default instance for this organization when no explicit integration is selected"
    },
    {
      "FieldName": "GitHubUrl",
      "DataType": "varchar(255)",
      "NotNullable": true,
      "Comment": "GitHub server URL (e.g., https://github.com or GitHub Enterprise URL)"
    },
    {
      "FieldName": "GitHubToken",
      "DataType": "text",
      "NotNullable": true,
      "Comment": "Encrypted GitHub API access token"
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when integration was created"
    },
    {
      "FieldName": "UpdatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when integration was last updated"
    }
  ]
}

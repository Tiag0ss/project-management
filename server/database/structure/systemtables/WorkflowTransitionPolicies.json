      "FromField": "OrganizationId",
      "ToTable": "Organizations",
      "ToField": "Id",
      "Type": "ManyToOne"
    },
    {
      "Name": "WorkflowTransitionPolicyFromStatus",
      "Description": "Source task status for transition",
      "FromField": "FromStatusId",
      "ToTable": "TaskStatusValues",
      "ToField": "Id",
      "Type": "ManyToOne"
    },
    {
      "Name": "WorkflowTransitionPolicyToStatus",
      "Description": "Target task status for transition",
      "FromField": "ToStatusId",
      "ToTable": "TaskStatusValues",
      "ToField": "Id",
      "Type": "ManyToOne"
    }
  ]
}

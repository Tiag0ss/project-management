      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - source memo"
    },
    {
      "FieldName": "RelatedMemoId",
      "DataType": "int",
      "NotNullable": true,
      "Comment": "Foreign key - related memo"
    },
    {
      "FieldName": "CreatedAt",
      "DataType": "timestamp",
      "NotNullable": true,
      "DefaultValue": "CURRENT_TIMESTAMP",
      "Comment": "Date and time when relation was created"
    }
  ]
}
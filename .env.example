# ============================================================================
# PRODUCTION CONFIGURATION - NEVER commit actual .env file to repository!
# ============================================================================

# Database Configuration
# Provider selection:
# - MySQL: DB_PROVIDER=mysql, DB_PORT=3306
# - MSSQL: DB_PROVIDER=mssql, DB_PORT=1433
DB_PROVIDER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=projectmanagement
DB_CONNECTION_LIMIT=20

# MSSQL-only settings (used when DB_PROVIDER=mssql)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT Configuration (REQUIRED - Generate a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-to-something-random

# Server Configuration
PORT=3000
NODE_ENV=development
# In production, set NODE_ENV=production

# API URL (backend base URL)
API_URL=http://localhost:3000
# Production example: https://api.yourdomain.com

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production example: https://yourdomain.com,https://www.yourdomain.com

# Logging Configuration
LOG_LEVEL=info
# Production: use 'warn' or 'error' to reduce log volume
# Possible values: error, warn, info, http, verbose, debug, silly

# Frontend Configuration (must start with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Production example: https://api.yourdomain.com or https://yourdomain.com (if same domain)

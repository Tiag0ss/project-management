# ============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# Copy this to .env.production and fill with actual production values
# ============================================================================

# Database Configuration (Use production database)
DB_HOST=your-production-db-host.com
DB_USER=prod_user
DB_PASSWORD=strong-production-password-here
DB_NAME=projectmanagement_prod
DB_CONNECTION_LIMIT=50

# JWT Configuration (REQUIRED - Use a strong random string)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use the same JWT_SECRET in dev and production!
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET_MINIMUM_64_CHARACTERS

# Server Configuration
PORT=3000
NODE_ENV=production

# API URL (backend base URL - adjust to your domain)
API_URL=https://api.yourdomain.com
# Or if same domain: https://yourdomain.com

# CORS Configuration (your production frontend URLs)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# Add any additional domains that should access the API

# Logging Configuration (reduce log volume in production)
LOG_LEVEL=warn
# Use 'error' for even less logging, 'info' for more details

# Frontend Configuration (must match your production frontend URL)
NEXT_PUBLIC_API_URL=https://yourdomain.com
# Or if separate API domain: https://api.yourdomain.com

# ============================================================================
# SECURITY CHECKLIST BEFORE DEPLOYMENT:
# ============================================================================
# ✓ JWT_SECRET generated with crypto.randomBytes(64)
# ✓ Strong database password
# ✓ ALLOWED_ORIGINS set to production domains only
# ✓ NODE_ENV=production
# ✓ LOG_LEVEL set to warn or error
# ✓ All URLs use HTTPS (not HTTP)
# ✓ Database user has minimum required permissions
# ✓ SSL/TLS certificates configured
# ✓ Firewall rules configured
# ✓ Database backups automated
# ============================================================================

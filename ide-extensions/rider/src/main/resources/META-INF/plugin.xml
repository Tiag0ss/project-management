<idea-plugin>
  <id>com.projectmanagement.pendingtasks</id>
  <name>Project Management — Kanban</name>
  <vendor>Project Management</vendor>
  <description><![CDATA[
    Project Kanban board in a tool window via API token (pt_). Select a project, drag cards to change status.
    Send to AI copies a prompt to the clipboard (JetBrains AI has no stable public prefill API in v1).
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="PM Kanban"
                anchor="right"
                factoryClass="com.projectmanagement.pendingtasks.KanbanToolWindowFactory"
                icon="/icons/pm.svg"/>
    <applicationConfigurable
            parentId="tools"
            instance="com.projectmanagement.pendingtasks.PmSettingsConfigurable"
            id="com.projectmanagement.pendingtasks.settings"
            displayName="Project Management"/>
    <notificationGroup id="Project Management" displayType="BALLOON"/>
  </extensions>
</idea-plugin>

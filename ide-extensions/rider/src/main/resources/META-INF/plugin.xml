<idea-plugin>
  <id>com.projectmanagement.pendingtasks</id>
  <name>Project Management — Pending Tasks</name>
  <vendor>Project Management</vendor>
  <description><![CDATA[
    Native tool window listing your pending tasks via API token (pt_). No webview.
    Send to AI copies a prompt to the clipboard (JetBrains AI has no stable public prefill API in v1).
  ]]></description>

  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="PM Pending Tasks"
                anchor="right"
                factoryClass="com.projectmanagement.pendingtasks.PendingTasksToolWindowFactory"
                icon="/icons/pm.svg"/>
    <applicationConfigurable
            parentId="tools"
            instance="com.projectmanagement.pendingtasks.PmSettingsConfigurable"
            id="com.projectmanagement.pendingtasks.settings"
            displayName="Project Management"/>
    <notificationGroup id="Project Management" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="pm.refreshTasks"
            class="com.projectmanagement.pendingtasks.RefreshTasksAction"
            text="Refresh Pending Tasks"
            description="Reload pending tasks from the API"/>
  </actions>
</idea-plugin>

# Docker environment variables
# Copy this to .env.docker and fill with your values
# This file is used by docker-compose.yml at runtime (NOT during image build)

# Database Configuration
# Provider selection:
# - MySQL: DB_PROVIDER=mysql, DB_PORT=3306, DB_HOST=mysql
# - MSSQL: DB_PROVIDER=mssql, DB_PORT=1433, DB_HOST=<sqlserver-host>
DB_PROVIDER=mysql
DB_HOST=mysql
DB_PORT=3306
DB_USER=appuser
DB_PASSWORD=strong-database-password-here
DB_NAME=projectmanagement
DB_CONNECTION_LIMIT=50

# MSSQL-only settings (used when DB_PROVIDER=mssql)
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# JWT Configuration (REQUIRED)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Logging
LOG_LEVEL=warn

# API URL
API_URL=http://localhost:3000

# Optional Redis (disabled by default — app runs fully without Redis)
# REDIS_ENABLED=true
# REDIS_URL=redis://redis:6379
# REDIS_KEY_PREFIX=pm:
# REDIS_DEFAULT_TTL_SECONDS=300

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
/.pnpm-store
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/jest-coverage
/android-app

# logs
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.next/
/out/
/pm-synapse/.next/
/pm-synapse/dist/
/pm-synapse/node_modules/
# PM Synapse has its own git repository (nested)
/pm-synapse/

# production
/build
/release

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# production build output
/dist
/dist/server

# environment files (NEVER commit these!)
.env
.env.local
.env.production
.env.production.local

# pm2
.pm2
pm2.log
ecosystem.config.js

# backups
/backups
*.sql.gz
templates/export.csv
package-lock.json

# Uploaded branding / application images (keep folder placeholders)
/public/uploads/branding/*
!/public/uploads/branding/.gitkeep
/public/uploads/applications/*
!/public/uploads/applications/.gitkeep
